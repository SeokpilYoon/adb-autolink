    <string name="hero_paused">Auto-connect is off</string>
    <string name="hero_paused_body">Turn it on to bring Wireless debugging back on your allowed Wi-Fi. You can also switch it from the Quick Settings tile.</string>
    <string name="resume_auto">Turn on auto-connect</string>
    <string name="hero_linked">Your PC can connect now</string>
    <string name="hero_setup">Finish setup to connect automatically</string>
    <string name="hero_off_allowed">Wireless debugging is off on this Wi-Fi</string>
