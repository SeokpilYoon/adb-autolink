    <string name="open_wireless_debugging_settings">Open Wireless debugging settings</string>

    <!-- Main screen: whitelist -->
    <string name="section_whitelist">Allowed Wi-Fi</string>
    <string name="whitelist_empty">None yet. Connect to your Wi-Fi and tap \"Allow this Wi-Fi\".</string>
    <string name="remove">Remove</string>
    <string name="section_advanced">Advanced</string>
    <string name="manual_toggle_label">Wireless debugging (manual)</string>

