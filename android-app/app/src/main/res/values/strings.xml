    <string name="hero_no_wifi">Not on Wi-Fi</string>
    <string name="section_current_network">Current network</string>
    <string name="ssid_hidden">SSID: &lt;unknown ssid&gt; - Android hides it. Grant location \"Allow all the time\" and turn location ON.</string>
