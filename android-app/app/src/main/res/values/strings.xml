    <string name="auth_timeout_current">Current: %1$s</string>
    <string name="auth_timeout_never">never expires</string>
    <plurals name="auth_timeout_hours">
        <item quantity="one">%d hour</item>
        <item quantity="other">%d hours</item>
    </plurals>
    <string name="disable_auth_timeout">Disable 7-day authorization timeout</string>
    <string name="auth_timeout_warning">Android forgets PC authorizations not used for 7 days. Disabling this keeps your PC authorized forever: anyone holding that PC\'s adb key can connect while Wireless debugging is on. Only use with trusted PCs and networks.</string>

