    <string name="allow_notifications">Allow notifications (status notification)</string>

    <string name="battery_optimization_on">Battery optimization: ON - the watcher may be killed</string>
    <string name="stop_optimizing_battery">Stop optimizing battery</string>
    <string name="samsung_battery_hint">Also set App info &gt; Battery &gt; \"Unrestricted\", and add this app to Settings &gt; Battery &gt; Background usage limits &gt; \"Never sleeping apps\".</string>
